# Terminal setup only. Edit by hand — don't regenerate with `brew bundle dump`
# (that would add every package on the machine).

# Terminal + font + prompt
cask "ghostty"
cask "font-jetbrains-mono-nerd-font"
brew "starship"
brew "zsh-autosuggestions"
brew "zsh-syntax-highlighting"
brew "zsh-history-substring-search"  # ↑/↓ search history by what's typed

# Tools .zshrc uses
brew "zoxide"   # `z` smart cd
brew "fzf"      # Ctrl+R history search, Ctrl+T file picker
brew "fd"       # fast file search (used by fzf)
brew "ripgrep"  # `rg`: fast text search in files
brew "bat"      # file previews in fzf
brew "eza"      # `ll` and `lt` aliases
brew "yazi"     # `y` file manager

# Everyday helpers
brew "btop"     # system monitor
brew "jq"       # read and filter JSON
brew "tlrc"     # `tldr <cmd>`: short usage examples

# Optional extras — uncomment to install
# brew "gh"       # GitHub CLI
# brew "lazygit"  # git UI in the terminal
